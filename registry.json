      "css": {
        "@layer base": {
          "body": {
            "font-weight": "500",
            "-webkit-font-smoothing": "antialiased",
            "-moz-osx-font-smoothing": "grayscale"
          }
        },
        "@layer utilities": {
          ".text-stat": {
            "font-family": "var(--font-serif)",
            "font-weight": "400",
            "letter-spacing": "-0.03em",
            "line-height": "1"
          },
          ".text-label": {
            "font-family": "var(--font-sans)",
            "font-weight": "600",
            "font-size": "13px",
            "letter-spacing": "0.01em",
            "line-height": "1.2"
          },
          ".text-body-lg": {
            "font-family": "var(--font-serif)",
            "font-weight": "400",
            "letter-spacing": "-0.01em",
            "line-height": "1.1"
          },
          ".text-uppercase": {
            "text-transform": "uppercase",
            "letter-spacing": "0.06em"
          },
          ".text-section-label": {
            "font-family": "var(--font-sans)",
            "font-size": "11px",
            "font-weight": "600",
            "text-transform": "uppercase",
            "letter-spacing": "0.06em",
            "line-height": "1.2",
            "color": "var(--gray-300)"
          }
        }
